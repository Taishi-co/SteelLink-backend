# Copy to .env and fill in real values. .env is gitignored.
# If MySQL / Redis live on a remote server, fill the remote host here.

# --- Server (optional; defaults in config.yaml) ---
# SERVER_PORT=8080
# SERVER_MODE=debug

# --- MySQL ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=steellink

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# --- JWT ---
JWT_SECRET=your-jwt-secret-key-change-in-production

# --- Kafka (comma-separated brokers) ---
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=steellink-backend
