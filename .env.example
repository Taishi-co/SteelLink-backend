# Copy to .env and fill in real values. .env is gitignored.
# If MySQL / Redis live on a remote server, fill the remote host here.

# --- Server (optional; defaults in config.yaml) ---
# SERVER_PORT=8080
# SERVER_MODE=debug

# --- MySQL ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=steellink

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# --- JWT ---
JWT_SECRET=your-jwt-secret-key-change-in-production

# --- Contract ---
# Defaults to simulated provider. Use CONTRACT_BASE_URL to control the
# placeholder contract URL returned in order details.
# CONTRACT_PROVIDER=simulated
# CONTRACT_BASE_URL=https://contracts.steellink.local/simulated

# --- SMS ---
# Defaults to dev provider, which logs verification codes. Set SMS_DEV_CODE
# locally to use a fixed 6-digit code for frontend/API integration testing.
# SMS_PROVIDER=dev
# SMS_DEV_CODE=123456

# --- Kafka (comma-separated brokers) ---
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=steellink-backend

# --- Tencent COS object storage ---
STORAGE_PROVIDER=tencent_cos
# Set STORAGE_PROVIDER=local only for local development fallback.
# STORAGE_LOCAL_DIR=./uploads
# STORAGE_LOCAL_BASE_URL=http://localhost:8080/uploads
COS_REGION=ap-beijing
COS_PUBLIC_BUCKET=steellink-public-1321917249
COS_PRIVATE_BUCKET=steellink-user-pri-1321917249
COS_ADMIN_BUCKET=steellink-admin-1321917249
COS_PUBLIC_BASE_URL=https://steellink-public-1321917249.cos.ap-beijing.myqcloud.com
COS_PRIVATE_BASE_URL=https://steellink-user-pri-1321917249.cos.ap-beijing.myqcloud.com
COS_ADMIN_BASE_URL=https://steellink-admin-1321917249.cos.ap-beijing.myqcloud.com
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
STORAGE_MAX_FILE_SIZE_MB=20

# --- AI Procurement model parsing ---
# Keep provider keys in environment variables. The admin page should store only
# the variable name, not the secret value.
AI_PROCUREMENT_MODEL_PARSING_ENABLED=false
AI_PROCUREMENT_PROVIDER=minimax
AI_PROCUREMENT_BASE_URL=https://api.minimax.io/v1/chat/completions
AI_PROCUREMENT_API_KEY_ENV=MINIMAX_API_KEY
AI_PROCUREMENT_MODEL=MiniMax-M2.7
AI_PROCUREMENT_TEMPERATURE=0.2
AI_PROCUREMENT_TOP_P=0.9
AI_PROCUREMENT_MAX_TOKENS=1200
AI_PROCUREMENT_TIMEOUT_SEC=20
AI_PROCUREMENT_CONFIDENCE_THRESHOLD=0.78
# MINIMAX_API_KEY=your-minimax-api-key

# --- AI Procurement vector retrieval ---
# pgvector should store product, supplier, and finance-product embeddings.
AI_PROCUREMENT_VECTOR_SEARCH_ENABLED=false
AI_PROCUREMENT_VECTOR_PROVIDER=pgvector
PGVECTOR_DSN_ENV=PGVECTOR_DSN
# PGVECTOR_DSN=postgres://user:password@host:5432/steellink_vectors?sslmode=disable
PGVECTOR_DATABASE=steellink_vectors
PGVECTOR_USERNAME=
PGVECTOR_PASSWORD_ENV=PGVECTOR_PASSWORD
# PGVECTOR_PASSWORD=your-pgvector-password
AI_PRODUCT_VECTOR_COLLECTION=ai_product_embeddings
AI_SUPPLIER_VECTOR_COLLECTION=ai_supplier_embeddings
AI_FINANCE_PRODUCT_VECTOR_COLLECTION=ai_finance_product_embeddings
AI_EMBEDDING_PROVIDER=minimax
AI_EMBEDDING_BASE_URL=https://api.minimax.io/v1/embeddings
AI_EMBEDDING_API_KEY_ENV=MINIMAX_API_KEY
AI_EMBEDDING_MODEL=embo-01
AI_EMBEDDING_DIMENSION=1536
AI_VECTOR_TOP_K=10
AI_VECTOR_MIN_SCORE=0.65
AI_HYBRID_KEYWORD_WEIGHT=0.35
AI_HYBRID_VECTOR_WEIGHT=0.65

# --- AI Procurement admin runtime config sync ---
# When enabled, buyer backend reads model/vector switches from SteelLink-admin.
# The token value must match AI_PROCUREMENT_CONFIG_SYNC_TOKEN on admin backend.
AI_PROCUREMENT_RUNTIME_CONFIG_ENABLED=false
AI_PROCUREMENT_RUNTIME_CONFIG_ENDPOINT=http://localhost:8081/api/v1/internal/ai-procurement/runtime-config
AI_PROCUREMENT_RUNTIME_CONFIG_TOKEN_ENV=AI_PROCUREMENT_CONFIG_SYNC_TOKEN
AI_PROCUREMENT_RUNTIME_CONFIG_CACHE_TTL_SEC=30
# AI_PROCUREMENT_CONFIG_SYNC_TOKEN=shared-internal-token
